# ==== Bora pros dados Brasil — configuração do site ====
# URL final do site (sem barra no fim). Usada em canonical, OG, sitemap e robots.
SITE_URL=https://SEU-DOMINIO.com.br
# ID de medição do Google Analytics 4 (formato G-XXXXXXXXXX). Sem ele o analytics fica inativo.
GA_MEASUREMENT_ID=G-XXXXXXXXXX
# Consentimento LGPD: "none" (carrega direto) ou "banner" (pede consentimento antes)
CONSENT_MODE=none

# ==== AWS (deploy) ====
AWS_PROFILE=default
AWS_REGION=us-east-1
S3_BUCKET=boraprosdadosbrasil-site
CLOUDFRONT_DISTRIBUTION_ID=
